# Choose one provider below. The application only reads this local file;
# never commit a real .env or API key.
LEDGER_AGENT_PROVIDER=volcengine

# Any OpenAI-compatible provider. The base URL stops at /v1; a full
# /v1/chat/completions URL is also accepted and normalized by the app.
LEDGER_AGENT_API_KEY=
LEDGER_AGENT_BASE_URL=https://your-openai-compatible-provider.example/v1
LEDGER_AGENT_MODEL=your-model-id
LEDGER_AGENT_TIMEOUT_SECONDS=120
LEDGER_AGENT_CLASSIFICATION_THRESHOLD=0.85
# Optional JSON. Rates use your billing currency per one million tokens.
# LEDGER_AGENT_MODEL_PRICING_JSON={"deepseek-v4-flash":{"input_per_million":0.0,"output_per_million":0.0,"cached_input_per_million":0.0}}

# Volcengine Ark, also using the OpenAI-compatible SDK protocol.
# Create an inference credential in Ark Console > API Key management.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-2-0-lite-260428

LEDGER_AGENT_DB=.financial_agent/ledger.db
DEFAULT_MONTHLY_INCOME=15000
DEFAULT_SAVING_GOAL=5000

# Optional speech-to-text for browser voice input.
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3-turbo
